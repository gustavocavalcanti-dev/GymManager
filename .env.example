# ============================================================
#  GymManager – Arquivo de configuração de ambiente
#  Copie este arquivo para .env e ajuste os valores.
#  NUNCA commite o .env real no repositório.
# ============================================================

# ---- Banco de Dados ----------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=gym_manager
DB_USERNAME=root
DB_PASSWORD=

# ---- Aplicação ---------------------------------------------
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/gymmanager

# ---- Sessão ------------------------------------------------
# Tempo de vida da sessão em segundos (padrão: 7200 = 2h)
SESSION_LIFETIME=7200
