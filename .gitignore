# Configurações sensíveis - NUNCA commitar
.env

# Documentação
README.md
.env.example
subir.md

# Dependências (se usar Composer no futuro)
/vendor/

# Uploads de usuários
/storage/uploads/*
!/storage/uploads/.gitkeep

# Backups de banco de dados
/database/backup/*.sql

# Cache e logs do sistema
/storage/logs/*.log
!/storage/logs/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep

# Arquivos do sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# IDEs e editores
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Node (caso use npm)
node_modules/
npm-debug.log

# Arquivos temporários do PHP
*.tmp
